// Cloudflare Workers 배포 설정 — 2026-10-19 Vercel에서 이사.
// 빌드: `SITE_URL=https://<배포 주소> npm run build` → dist/ 를 그대로 내보낸다(공유 미리보기 절대 주소, vite.config.ts)
{
  "name": "bybit-rr",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/bybit-api/*"]
  },
  // 주소는 1rc.app(2026-10-19 구입, Cloudflare Registrar) — 예비 주소(workers.dev)는 꺼서 한 곳으로
  "routes": [
    { "pattern": "1rc.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
