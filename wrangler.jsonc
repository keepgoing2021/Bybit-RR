// Cloudflare Workers 배포 설정 — 2026-10-19 Vercel에서 이사.
// 빌드: `SITE_URL=https://<배포 주소> npm run build` → dist/ 를 그대로 내보낸다(공유 미리보기 절대 주소, vite.config.ts)
{
  "name": "bybit-rr",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  // 배포 전에 테스트 → 빌드. Cloudflare 자동 배포(GitHub main에 올라가면)도 손 배포(npm run deploy)도
  // `wrangler deploy`가 이것부터 돌리므로 대시보드의 빌드 명령은 비워 둬도 된다. 테스트가 실패하면 배포하지 않는다
  "build": { "command": "npm test && npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/bybit-api/*"]
  },
  // 주소는 1rc.app(2026-10-19 구입, Cloudflare Registrar) — 예비 주소(workers.dev)는 꺼서 한 곳으로
  "routes": [
    { "pattern": "1rc.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
