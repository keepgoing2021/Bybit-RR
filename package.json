{
  "name": "bybit-rr-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bybit USDT 무기한 선물용 손익비(RR) 시나리오 차트 툴",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:bybit": "node scripts/check-bybit.mjs",
    "deploy": "npx --yes wrangler deploy"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.149.0",
    "ws": "^8.22.0"
  }
}
